{
  "expo": {
    "name": "Ingatlan CRM",
    "slug": "ingatlan-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Az ingatlanokhoz tartozó fotók kiválasztásához.",
          "cameraPermission": "Az ingatlanok lefotózásához a helyszínen."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366f1"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "ingatlancrm",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8bf8c6cc-dd70-4db8-8da5-1cd4355c5158"
      }
    },
    "owner": "ixscoot"
  }
}
